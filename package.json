{
  "name": "@fastly/compute-js-context",
  "version": "0.6.1",
  "description": "Surfaces Fastly Compute environment as a context object",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fastly/compute-js-context.git"
  },
  "author": {
    "name": "Katsuyuki Omuro",
    "email": "komuro@fastly.com"
  },
  "type": "module",
  "main": "./build/index.js",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "types": "./build/index.d.ts",
  "scripts": {
    "prepack": "npm run clean:build && npm run build",
    "build": "tsc -p tsconfig.build.json",
    "clean": "npm run clean:build && rm -rf test/integration/.work",
    "clean:build": "rm -rf build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "npm run typecheck && npm run test:unit",
    "test:unit": "node --import ./test/unit/hooks.ts --test \"test/unit/**/*.test.ts\"",
    "test:coverage": "node --import ./test/unit/hooks.ts --test --experimental-test-coverage --test-coverage-include=\"src/**\" \"test/unit/**/*.test.ts\"",
    "test:integration": "npm run clean && npm run build && node test/integration/build-apps.mjs && node --test test/integration/context.test.ts"
  },
  "devDependencies": {
    "@fastly/js-compute": "^4.0.0",
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@fastly/js-compute": "^3.33.0 || ^4.0.0"
  },
  "files": [
    "build/**/*.js",
    "build/**/*.js.map",
    "build/**/*.d.ts",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "keywords": [
    "fastly",
    "compute",
    "context"
  ]
}
